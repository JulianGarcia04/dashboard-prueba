rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email in ['product@menupp.co'];
    }
    match /excel-uploads/{file} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }
    match /orders/{file} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
